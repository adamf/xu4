#
# Makefile for macOS (Apple Silicon or Intel)
#
# GLFW, Boron & Faun are compiled from the src/glfw, src/boron & src/faun
# Git submodules (git submodule update --init).  Their objects go in src/obj
# so the submodule checkouts stay clean.  The Boron interpreter used to pack
# the game modules is also built here (obj/bin/boron).
#
# libpng & libvorbis come from Homebrew (brew install libpng libvorbis).
# Their static libraries are linked so XU4.app runs on Macs without Homebrew.
#

-include ../make.config

UI    = glfw
SOUND = faun
GPU  ?= scale

BREW ?= $(firstword $(wildcard /opt/homebrew /usr/local))
OBJ   = obj

.DEFAULT_GOAL := xu4

SUBMODULE_FILES = glfw/src/init.c boron/eval/boron.c faun/faun.c
ifneq ($(filter-out $(wildcard $(SUBMODULE_FILES)),$(SUBMODULE_FILES)),)
$(error Submodules are missing.  Run: git submodule update --init)
endif

# Homebrew's static libraries target the macOS release they were built on.
MACOSX_DEPLOYMENT_TARGET ?= 26.0
export MACOSX_DEPLOYMENT_TARGET
MINVER = -mmacosx-version-min=$(MACOSX_DEPLOYMENT_TARGET)

CC  = clang
CXX = clang++

OPT = -O2 -DNDEBUG
#OPT = -g -DDEBUG

DEFS = -DUSE_BORON -DCONF_MODULE -DUSE_GL -DVERSION=\"$(VERSION)\"
ifeq ($(GPU),all)
DEFS += -DGPU_RENDER
endif

INCS = -I. -Isupport -Ifaun -Iglfw/include -I$(OBJ)/include \
       -I$(BREW)/opt/libpng/include -I$(BREW)/opt/libvorbis/include \
       -I$(BREW)/opt/libogg/include

CFLAGS   = -Wall -Wno-unused-parameter $(OPT) $(INCS) $(DEFS) $(MINVER)
CXXFLAGS = $(CFLAGS)

# Some Command Line Tools updates leave a stale, partial libc++ header
# directory in the toolchain that hides the complete one in the SDK.
SDKROOT ?= $(shell xcrun --show-sdk-path 2>/dev/null)
TOOLCHAIN_CXX_INC := $(dir $(shell xcrun -f clang++ 2>/dev/null))../include/c++/v1
ifeq ($(wildcard $(TOOLCHAIN_CXX_INC)/vector),)
ifneq ($(wildcard $(SDKROOT)/usr/include/c++/v1/vector),)
CXXFLAGS += -nostdinc++ -isystem $(SDKROOT)/usr/include/c++/v1
endif
endif

# Prefer a static library; fall back to a shared one.
# $(call staticlib,<archive path>,<fallback link flags>)
staticlib = $(or $(wildcard $(1)),$(2))

PNG_LIB    = $(call staticlib,$(BREW)/opt/libpng/lib/libpng16.a,-lpng)
VORBIS_LIB = $(call staticlib,$(BREW)/opt/libvorbis/lib/libvorbisfile.a,-lvorbisfile) \
             $(call staticlib,$(BREW)/opt/libvorbis/lib/libvorbis.a,-lvorbis) \
             $(call staticlib,$(BREW)/opt/libogg/lib/libogg.a,-logg)

FRAMEWORKS = -framework Cocoa -framework IOKit -framework CoreFoundation \
             -framework CoreVideo -framework OpenGL \
             -framework AudioToolbox -framework CoreAudio

LIBS = $(PNG_LIB) $(VORBIS_LIB) -lz -lm $(FRAMEWORKS)


#---------------------------------------------------------------------------
# GLFW (Cocoa backend)

GLFW_SRC = context.c init.c input.c monitor.c platform.c vulkan.c window.c \
           egl_context.c osmesa_context.c null_init.c null_monitor.c \
           null_window.c null_joystick.c cocoa_time.c posix_module.c \
           posix_thread.c cocoa_init.m cocoa_joystick.m cocoa_monitor.m \
           cocoa_window.m nsgl_context.m
GLFW_OBJS  = $(addprefix $(OBJ)/glfw/,$(addsuffix .o,$(basename $(GLFW_SRC))))
GLFW_FLAGS = -O2 -D_GLFW_COCOA -Iglfw/include $(MINVER)

$(OBJ)/glfw/%.o: glfw/src/%.c | $(OBJ)/glfw
	$(CC) -c $(GLFW_FLAGS) $< -o $@

$(OBJ)/glfw/%.o: glfw/src/%.m | $(OBJ)/glfw
	$(CC) -c $(GLFW_FLAGS) $< -o $@


#---------------------------------------------------------------------------
# Boron (configured as xu4's dist/Makefile does: no execute or socket,
# static, threads)

BORON_CONFIG = -DCONFIG_CHECKSUM -DCONFIG_COMPRESS=1 -DCONFIG_HASHMAP \
               -DCONFIG_RANDOM -DCONFIG_LINENOISE -DCONFIG_STATIC \
               -DCONFIG_THREAD
BORON_FLAGS  = -std=c99 -O3 -DNDEBUG -Iboron/include -Iboron/urlan \
               -Iboron/eval -Iboron/support $(BORON_CONFIG) $(MINVER)

BORON_SRC = urlan/env.c urlan/array.c urlan/binary.c urlan/block.c \
            urlan/coord.c urlan/date.c urlan/path.c urlan/string.c \
            urlan/context.c urlan/gc.c urlan/serialize.c urlan/tokenize.c \
            urlan/vector.c urlan/parse_block.c urlan/parse_string.c \
            urlan/hashmap.c support/str.c support/mem_util.c \
            support/quickSortIndex.c support/fpconv.c support/well512.c \
            unix/os.c eval/boron.c eval/port_file.c eval/wait.c \
            eval/random.c eval/port_thread.c
BORON_OBJS = $(addprefix $(OBJ)/boron/,$(notdir $(BORON_SRC:.c=.o)))
BORON_EXE_OBJS = $(OBJ)/boron/main.o $(OBJ)/boron/linenoise.o

# Headers are copied so they can be included as <boron/boron.h>.
BORON_HDRS = $(addprefix $(OBJ)/include/boron/,boron.h urlan.h urlan_atoms.h)

$(OBJ)/boron/%.o: boron/urlan/%.c | $(OBJ)/boron
	$(CC) -c $(BORON_FLAGS) $< -o $@

$(OBJ)/boron/%.o: boron/support/%.c | $(OBJ)/boron
	$(CC) -c $(BORON_FLAGS) $< -o $@

$(OBJ)/boron/%.o: boron/eval/%.c | $(OBJ)/boron
	$(CC) -c $(BORON_FLAGS) $< -o $@

$(OBJ)/boron/%.o: boron/unix/%.c | $(OBJ)/boron
	$(CC) -c $(BORON_FLAGS) $< -o $@

$(OBJ)/include/boron/%.h: boron/include/%.h | $(OBJ)/include/boron
	cp $< $@

# The interpreter program used by ../Makefile to pack modules.
$(OBJ)/bin/boron: $(BORON_EXE_OBJS) $(BORON_OBJS) | $(OBJ)/bin
	$(CC) $(MINVER) $^ -o $@ -lz -lm


#---------------------------------------------------------------------------
# Faun (CoreAudio backend)

FAUN_OBJS  = $(OBJ)/faun/faun.o $(OBJ)/faun/tmsg.o
FAUN_FLAGS = -Wall -W -O2 -DNDEBUG -DUSE_LOAD_MEM -DUSE_SFX_GEN \
             -Ifaun/support -I$(BREW)/opt/libvorbis/include \
             -I$(BREW)/opt/libogg/include $(MINVER)

$(OBJ)/faun/faun.o: faun/faun.c faun/sys_coreaudio.c faun/internal.h \
                    faun/faun.h | $(OBJ)/faun
	$(CC) -c $(FAUN_FLAGS) $< -o $@

$(OBJ)/faun/tmsg.o: faun/support/tmsg.c faun/support/tmsg.h | $(OBJ)/faun
	$(CC) -c $(FAUN_FLAGS) $< -o $@


#---------------------------------------------------------------------------
# XU4

OBJS = macosx/osxerror.o $(FAUN_OBJS) $(GLFW_OBJS) $(BORON_OBJS)

include Makefile.common

# Sources include <boron/boron.h>.
$(OBJS): | $(BORON_HDRS)

macosx/osxerror.o: macosx/osxerror.mm error.h
	$(CXX) $(CXXFLAGS) -fobjc-arc -c -o $@ $<

$(OBJ)/glfw $(OBJ)/boron $(OBJ)/faun $(OBJ)/bin $(OBJ)/include/boron:
	mkdir -p $@

clean::
	rm -rf $(OBJ)

-include .depends
